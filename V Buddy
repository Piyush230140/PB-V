// ==UserScript==
// @name         Desktop Companion - Virtual Pet
// @namespace    http://tampermonkey.net/
// @version      1.0.0
// @description  A customizable, interactive desktop pet companion script.
// @author       You
// @match        *://*/*
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        GM_registerMenuCommand
// @run-at       document-end
// ==/UserScript==

(function () {
  'use strict';

  // =========================================================================
  // 1. CONFIGURATION & ANIMATION REGISTRY
  // =========================================================================

  /**
   * Add new hosted animation URLs here to extend pet actions seamlessly.
   */
  const ANIMATION_REGISTRY = {
    wave: {
      id: 'wave',
      name: 'Wave',
      url: 'https://github.com/Piyush230140/PB-V/blob/main/Greeting%20Wave.gif',
      type: 'greeting',
    },
    headTilt: {
      id: 'headTilt',
      name: 'Head Tilt',
      url: 'https://raw.githubusercontent.com/YOUR_USER/YOUR_REPO/main/head_tilt.webm',
      type: 'greeting',
    },
    happyBounce: {
      id: 'happyBounce',
      name: 'Happy Bounce',
      url: 'https://raw.githubusercontent.com/YOUR_USER/YOUR_REPO/main/happy_bounce.webm',
      type: 'greeting',
    },
    drinkWater: {
      id: 'drinkWater',
      name: 'Drink Water',
      url: 'https://raw.githubusercontent.com/YOUR_USER/YOUR_REPO/main/drink_water.webm',
      type: 'drink',
    },
  };

  const DEFAULT_SETTINGS = {
    general: {
      enabled: true,
      speechBubbleEnabled: true,
      animationsEnabled: true,
      soundsEnabled: false,
      opacity: 1.0,
      volume: 0.8,
    },
    appearance: {
      size: 'medium', // small, medium, large, xlarge
      animationSpeed: 'normal', // slow, normal, fast
    },
    position: {
      defaultPos: 'bottom-right', // bottom-right, bottom-left, top-right, top-left
      customX: null,
      customY: null,
      snapToEdges: true,
    },
    movement: {
      entrance: 'popup', // popup, fade, slide, bounce
      exit: 'slidedown', // fade, slidedown, walkaway
      idle: 'breathing', // breathing, floating, blink, disable
    },
    timings: {
      greetingEnabled: true,
      greetingIntervalMinutes: 60,
      drinkEnabled: true,
      drinkIntervalMinutes: 45,
      randomOffsetMinutes: 5,
      stayDurationSeconds: 5,
      speechBubbleDurationSeconds: 4,
    },
    messageCategories: {
      greetings: true,
      compliments: true,
      motivation: true,
      water: true,
      break: true,
      sleep: true,
    },
    messages: {
      greetings: [
        "You're beautiful! 💙",
        'Have a wonderful day! ☀️',
        "Hope you're smiling today! 😊",
        "Wishing you an amazing day!",
      ],
      compliments: [
        " You're doing amazing!",
        'Never forget how awesome you are.',
        'You deserve good things.',
      ],
      motivation: [
        'Believe in yourself!',
        "Keep going—you've got this!",
        "I'm cheering for you!",
      ],
      water: [
        'Drink some water! 💧',
        'Hydration check!',
        'Stay hydrated!',
        'Time for a sip!',
        'Water break!',
        "Don't forget to hydrate!",
      ],
      break: ['Take a short stretch break!', 'Rest your eyes for a minute! 👁️'],
      sleep: ['Getting late, make sure to get good rest tonight! 🌙'],
    },
    enabledAnimations: {
      wave: true,
      headTilt: true,
      happyBounce: true,
      drinkWater: true,
    },
    behavior: {
      interactionFrequency: 'normal', // very_rare, rare, normal, frequent, very_frequent
      dnd: true, // Do not disturb on video/fullscreen
    },
  };

  // =========================================================================
  // 2. STORAGE MANAGER
  // =========================================================================
  class StorageManager {
    static getSettings() {
      const saved = GM_getValue('desktop_pet_settings', null);
      if (!saved) return DEFAULT_SETTINGS;
      try {
        return Object.assign({}, DEFAULT_SETTINGS, JSON.parse(saved));
      } catch (e) {
        return DEFAULT_SETTINGS;
      }
    }

    static saveSettings(settings) {
      GM_setValue('desktop_pet_settings', JSON.stringify(settings));
    }
  }

  // =========================================================================
  // 3. MESSAGE MANAGER
  // =========================================================================
  class MessageManager {
    constructor(settings) {
      this.settings = settings;
      this.lastGreetingMsg = null;
      this.lastDrinkMsg = null;
    }

    getRandomMessage(type = 'greeting') {
      const categories = this.settings.messageCategories;
      const msgs = this.settings.messages;
      let pool = [];

      if (type === 'drink' && categories.water) {
        pool = [...(msgs.water || [])];
      } else {
        if (categories.greetings) pool.push(...(msgs.greetings || []));
        if (categories.compliments) pool.push(...(msgs.compliments || []));
        if (categories.motivation) pool.push(...(msgs.motivation || []));
        if (categories.break) pool.push(...(msgs.break || []));
        if (categories.sleep) pool.push(...(msgs.sleep || []));
      }

      if (pool.length === 0) return 'Hello there! 👋';

      const lastMsg = type === 'drink' ? this.lastDrinkMsg : this.lastGreetingMsg;
      let filtered = pool.filter((m) => m !== lastMsg);
      if (filtered.length === 0) filtered = pool;

      const selected = filtered[Math.floor(Math.random() * filtered.length)];

      if (type === 'drink') this.lastDrinkMsg = selected;
      else this.lastGreetingMsg = selected;

      return selected;
    }
  }

  // =========================================================================
  // 4. SPEECH BUBBLE MANAGER
  // =========================================================================
  class SpeechBubbleManager {
    constructor(petContainer) {
      this.petContainer = petContainer;
      this.element = null;
      this.init();
    }

    init() {
      this.element = document.createElement('div');
      this.element.id = 'pet-speech-bubble';
      this.element.className = 'pet-speech-bubble hidden';
      this.petContainer.appendChild(this.element);
    }

    show(text, durationMs) {
      this.element.innerText = text;
      this.element.classList.remove('hidden');
      this.element.classList.add('visible');

      if (this.hideTimeout) clearTimeout(this.hideTimeout);
      this.hideTimeout = setTimeout(() => {
        this.hide();
      }, durationMs);
    }

    hide() {
      this.element.classList.remove('visible');
      this.element.classList.add('hidden');
    }
  }

  // =========================================================================
  // 5. ANIMATION MANAGER
  // =========================================================================
  class AnimationManager {
    constructor(settings) {
      this.settings = settings;
      this.lastAnimation = null;
    }

    getRandomGreetingAnimation() {
      const enabled = this.settings.enabledAnimations;
      const candidateKeys = Object.keys(ANIMATION_REGISTRY).filter(
        (key) => ANIMATION_REGISTRY[key].type === 'greeting' && enabled[key]
      );

      if (candidateKeys.length === 0) return ANIMATION_REGISTRY.wave;

      let filtered = candidateKeys.filter((k) => k !== this.lastAnimation);
      if (filtered.length === 0) filtered = candidateKeys;

      const chosenKey = filtered[Math.floor(Math.random() * filtered.length)];
      this.lastAnimation = chosenKey;
      return ANIMATION_REGISTRY[chosenKey];
    }

    getDrinkAnimation() {
      return ANIMATION_REGISTRY.drinkWater;
    }
  }

  // =========================================================================
  // 6. PET MANAGER
  // =========================================================================
  class PetManager {
    constructor(settingsManager) {
      this.settingsManager = settingsManager;
      this.settings = settingsManager.get();
      this.animationManager = new AnimationManager(this.settings);
      this.messageManager = new MessageManager(this.settings);

      this.container = null;
      this.mediaElement = null;
      this.speechBubble = null;
      this.isVisible = false;
      this.isDragging = false;

      this.initDOM();
      this.applyStyles();
      this.setupDragging();
    }

    initDOM() {
      this.container = document.createElement('div');
      this.container.id = 'desktop-pet-container';
      this.container.className = 'desktop-pet-wrapper hidden';

      this.mediaContainer = document.createElement('div');
      this.mediaContainer.className = 'pet-media-box';

      this.container.appendChild(this.mediaContainer);
      document.body.appendChild(this.container);

      this.speechBubble = new SpeechBubbleManager(this.container);
    }

    applyStyles() {
      const sizeMap = {
        small: '120px',
        medium: '180px',
        large: '240px',
        xlarge: '300px',
      };

      const speedMap = {
        slow: '1.5s',
        normal: '0.8s',
        fast: '0.4s',
      };

      const size = sizeMap[this.settings.appearance.size] || '180px';
      const speed = speedMap[this.settings.appearance.animationSpeed] || '0.8s';

      this.container.style.setProperty('--pet-size', size);
      this.container.style.setProperty('--anim-speed', speed);
      this.container.style.opacity = this.settings.general.opacity;

      this.setPosition();
    }

    setPosition() {
      if (this.settings.position.customX !== null && this.settings.position.customY !== null) {
        this.container.style.left = `${this.settings.position.customX}px`;
        this.container.style.top = `${this.settings.position.customY}px`;
        this.container.style.bottom = 'auto';
        this.container.style.right = 'auto';
        return;
      }

      this.container.style.top = 'auto';
      this.container.style.bottom = 'auto';
      this.container.style.left = 'auto';
      this.container.style.right = 'auto';

      switch (this.settings.position.defaultPos) {
        case 'top-left':
          this.container.style.top = '20px';
          this.container.style.left = '20px';
          break;
        case 'top-right':
          this.container.style.top = '20px';
          this.container.style.right = '20px';
          break;
        case 'bottom-left':
          this.container.style.bottom = '20px';
          this.container.style.left = '20px';
          break;
        case 'bottom-right':
        default:
          this.container.style.bottom = '20px';
          this.container.style.right = '20px';
          break;
      }
    }

    setupDragging() {
      let offsetX, offsetY;

      const onMouseDown = (e) => {
        if (e.button !== 0) return;
        this.isDragging = true;
        const rect = this.container.getBoundingClientRect();
        offsetX = e.clientX - rect.left;
        offsetY = e.clientY - rect.top;
        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
      };

      const onMouseMove = (e) => {
        if (!this.isDragging) return;
        let x = e.clientX - offsetX;
        let y = e.clientY - offsetY;

        if (this.settings.position.snapToEdges) {
          const snapDist = 20;
          if (x < snapDist) x = 0;
          if (y < snapDist) y = 0;
          if (window.innerWidth - (x + rectWidth()) < snapDist) x = window.innerWidth - rectWidth();
          if (window.innerHeight - (y + rectHeight()) < snapDist) y = window.innerHeight - rectHeight();
        }

        this.container.style.left = `${x}px`;
        this.container.style.top = `${y}px`;
        this.container.style.bottom = 'auto';
        this.container.style.right = 'auto';
      };

      const rectWidth = () => this.container.offsetWidth;
      const rectHeight = () => this.container.offsetHeight;

      const onMouseUp = () => {
        if (this.isDragging) {
          this.isDragging = false;
          document.removeEventListener('mousemove', onMouseMove);
          document.removeEventListener('mouseup', onMouseUp);

          const rect = this.container.getBoundingClientRect();
          this.settings.position.customX = rect.left;
          this.settings.position.customY = rect.top;
          this.settingsManager.save();
        }
      };

      this.container.addEventListener('mousedown', onMouseDown);
    }

    isDNDActive() {
      if (!this.settings.behavior.dnd) return false;
      const isFullscreen = !!document.fullscreenElement;
      const hasPlayingVideo = Array.from(document.querySelectorAll('video')).some(
        (v) => !v.paused && !v.ended
      );
      return isFullscreen || hasPlayingVideo;
    }

    triggerInteraction(type = 'greeting') {
      if (!this.settings.general.enabled || this.isDNDActive() || this.isVisible) return;

      this.isVisible = true;

      const animData =
        type === 'drink'
          ? this.animationManager.getDrinkAnimation()
          : this.animationManager.getRandomGreetingAnimation();

      this.loadMedia(animData.url);

      const entranceClass = `anim-enter-${this.settings.movement.entrance}`;
      this.container.className = `desktop-pet-wrapper ${entranceClass}`;

      const msg = this.messageManager.getRandomMessage(type);

      if (this.settings.general.speechBubbleEnabled) {
        const bubbleTime = this.settings.timings.speechBubbleDurationSeconds * 1000;
        this.speechBubble.show(msg, bubbleTime);
      }

      const stayTime = this.settings.timings.stayDurationSeconds * 1000;
      setTimeout(() => {
        this.dismiss();
      }, stayTime);
    }

    loadMedia(url) {
      this.mediaContainer.innerHTML = '';

      if (url.endsWith('.webm') || url.endsWith('.mp4')) {
        const video = document.createElement('video');
        video.src = url;
        video.autoplay = true;
        video.loop = true;
        video.muted = true;
        video.playsInline = true;
        video.className = 'pet-media';
        this.mediaContainer.appendChild(video);
      } else {
        const img = document.createElement('img');
        img.src = url;
        img.className = 'pet-media';
        this.mediaContainer.appendChild(img);
      }
    }

    dismiss() {
      const exitClass = `anim-exit-${this.settings.movement.exit}`;
      this.container.className = `desktop-pet-wrapper ${exitClass}`;

      setTimeout(() => {
        this.container.className = 'desktop-pet-wrapper hidden';
        this.mediaContainer.innerHTML = '';
        this.isVisible = false;
      }, 1000);
    }
  }

  // =========================================================================
  // 7. REMINDER MANAGER
  // =========================================================================
  class ReminderManager {
    constructor(petManager, settings) {
      this.pet = petManager;
      this.settings = settings;
      this.greetingTimer = null;
      this.drinkTimer = null;
      this.startTimers();
    }

    startTimers() {
      this.scheduleNextGreeting();
      this.scheduleNextDrink();
    }

    calculateInterval(baseMinutes) {
      const offset = (Math.random() * 2 - 1) * this.settings.timings.randomOffsetMinutes;
      const totalMinutes = Math.max(1, baseMinutes + offset);
      return totalMinutes * 60 * 1000;
    }

    scheduleNextGreeting() {
      if (this.greetingTimer) clearTimeout(this.greetingTimer);
      if (!this.settings.timings.greetingEnabled) return;

      const ms = this.calculateInterval(this.settings.timings.greetingIntervalMinutes);
      this.greetingTimer = setTimeout(() => {
        this.pet.triggerInteraction('greeting');
        this.scheduleNextGreeting();
      }, ms);
    }

    scheduleNextDrink() {
      if (this.drinkTimer) clearTimeout(this.drinkTimer);
      if (!this.settings.timings.drinkEnabled) return;

      const ms = this.calculateInterval(this.settings.timings.drinkIntervalMinutes);
      this.drinkTimer = setTimeout(() => {
        this.pet.triggerInteraction('drink');
        this.scheduleNextDrink();
      }, ms);
    }

    reset() {
      this.startTimers();
    }
  }

  // =========================================================================
  // 8. SETTINGS MANAGER & UI PANEL
  // =========================================================================
  class SettingsManager {
    constructor() {
      this.settings = StorageManager.getSettings();
    }

    get() {
      return this.settings;
    }

    save() {
      StorageManager.saveSettings(this.settings);
    }
  }

  class SettingsUI {
    constructor(settingsManager, petManager, reminderManager) {
      this.sm = settingsManager;
      this.settings = settingsManager.get();
      this.pet = petManager;
      this.reminders = reminderManager;
      this.panel = null;

      GM_registerMenuCommand('Configure Desktop Pet', () => this.toggle());
    }

    toggle() {
      if (this.panel) {
        this.close();
      } else {
        this.open();
      }
    }

    open() {
      this.panel = document.createElement('div');
      this.panel.id = 'pet-settings-panel';
      this.panel.innerHTML = this.renderHTML();
      document.body.appendChild(this.panel);
      this.bindEvents();
    }

    close() {
      if (this.panel) {
        this.panel.remove();
        this.panel = null;
      }
    }

    renderHTML() {
      const s = this.settings;
      return `
        <div class="pet-settings-backdrop"></div>
        <div class="pet-settings-dialog">
          <h2>🐾 Desktop Companion Settings</h2>
          <div class="pet-settings-body">

            <!-- General -->
            <fieldset>
              <legend>General</legend>
              <label><input type="checkbox" id="set-gen-enable" ${s.general.enabled ? 'checked' : ''}> Enable Pet</label>
              <label><input type="checkbox" id="set-gen-bubble" ${s.general.speechBubbleEnabled ? 'checked' : ''}> Enable Speech Bubble</label>
              <label>Opacity: <input type="range" id="set-gen-opacity" min="0.5" max="1" step="0.1" value="${s.general.opacity}"></label>
            </fieldset>

            <!-- Appearance -->
            <fieldset>
              <legend>Appearance</legend>
              <label>Size:
                <select id="set-app-size">
                  <option value="small" ${s.appearance.size === 'small' ? 'selected' : ''}>Small</option>
                  <option value="medium" ${s.appearance.size === 'medium' ? 'selected' : ''}>Medium</option>
                  <option value="large" ${s.appearance.size === 'large' ? 'selected' : ''}>Large</option>
                  <option value="xlarge" ${s.appearance.size === 'xlarge' ? 'selected' : ''}>Extra Large</option>
                </select>
              </label>
              <label>Animation Speed:
                <select id="set-app-speed">
                  <option value="slow" ${s.appearance.animationSpeed === 'slow' ? 'selected' : ''}>Slow</option>
                  <option value="normal" ${s.appearance.animationSpeed === 'normal' ? 'selected' : ''}>Normal</option>
                  <option value="fast" ${s.appearance.animationSpeed === 'fast' ? 'selected' : ''}>Fast</option>
                </select>
              </label>
            </fieldset>

            <!-- Movement -->
            <fieldset>
              <legend>Movement & Position</legend>
              <label>Default Corner:
                <select id="set-pos-corner">
                  <option value="bottom-right" ${s.position.defaultPos === 'bottom-right' ? 'selected' : ''}>Bottom Right</option>
                  <option value="bottom-left" ${s.position.defaultPos === 'bottom-left' ? 'selected' : ''}>Bottom Left</option>
                  <option value="top-right" ${s.position.defaultPos === 'top-right' ? 'selected' : ''}>Top Right</option>
                  <option value="top-left" ${s.position.defaultPos === 'top-left' ? 'selected' : ''}>Top Left</option>
                </select>
              </label>
              <button id="btn-reset-pos" class="pet-btn">Reset Dragged Position</button>
              <label>Entrance Style:
                <select id="set-mov-entrance">
                  <option value="popup" ${s.movement.entrance === 'popup' ? 'selected' : ''}>Pop Up</option>
                  <option value="fade" ${s.movement.entrance === 'fade' ? 'selected' : ''}>Fade In</option>
                  <option value="slide" ${s.movement.entrance === 'slide' ? 'selected' : ''}>Slide In</option>
                </select>
              </label>
            </fieldset>

            <!-- Timings -->
            <fieldset>
              <legend>Timings & Reminders</legend>
              <label><input type="checkbox" id="set-time-greet-enable" ${s.timings.greetingEnabled ? 'checked' : ''}> Greeting Reminders</label>
              <label>Greeting Interval (mins): <input type="number" id="set-time-greet-int" value="${s.timings.greetingIntervalMinutes}"></label>
              <label><input type="checkbox" id="set-time-drink-enable" ${s.timings.drinkEnabled ? 'checked' : ''}> Drink Reminders</label>
              <label>Drink Interval (mins): <input type="number" id="set-time-drink-int" value="${s.timings.drinkIntervalMinutes}"></label>
              <label>Stay On Screen (sec): <input type="number" id="set-time-stay" value="${s.timings.stayDurationSeconds}"></label>
            </fieldset>

            <!-- Test Controls -->
            <fieldset>
              <legend>Quick Test</legend>
              <button id="btn-test-greet" class="pet-btn">Test Greeting</button>
              <button id="btn-test-drink" class="pet-btn">Test Drink Reminder</button>
            </fieldset>

          </div>
          <div class="pet-settings-footer">
            <button id="btn-save-settings" class="pet-btn primary">Save & Close</button>
          </div>
        </div>
      `;
    }

    bindEvents() {
      this.panel.querySelector('.pet-settings-backdrop').addEventListener('click', () => this.close());

      this.panel.querySelector('#btn-reset-pos').addEventListener('click', () => {
        this.settings.position.customX = null;
        this.settings.position.customY = null;
        this.pet.setPosition();
      });

      this.panel.querySelector('#btn-test-greet').addEventListener('click', () => {
        this.pet.triggerInteraction('greeting');
      });

      this.panel.querySelector('#btn-test-drink').addEventListener('click', () => {
        this.pet.triggerInteraction('drink');
      });

      this.panel.querySelector('#btn-save-settings').addEventListener('click', () => {
        const s = this.settings;
        s.general.enabled = this.panel.querySelector('#set-gen-enable').checked;
        s.general.speechBubbleEnabled = this.panel.querySelector('#set-gen-bubble').checked;
        s.general.opacity = parseFloat(this.panel.querySelector('#set-gen-opacity').value);

        s.appearance.size = this.panel.querySelector('#set-app-size').value;
        s.appearance.animationSpeed = this.panel.querySelector('#set-app-speed').value;

        s.position.defaultPos = this.panel.querySelector('#set-pos-corner').value;
        s.movement.entrance = this.panel.querySelector('#set-mov-entrance').value;

        s.timings.greetingEnabled = this.panel.querySelector('#set-time-greet-enable').checked;
        s.timings.greetingIntervalMinutes = parseInt(this.panel.querySelector('#set-time-greet-int').value, 10);
        s.timings.drinkEnabled = this.panel.querySelector('#set-time-drink-enable').checked;
        s.timings.drinkIntervalMinutes = parseInt(this.panel.querySelector('#set-time-drink-int').value, 10);
        s.timings.stayDurationSeconds = parseInt(this.panel.querySelector('#set-time-stay').value, 10);

        this.sm.save();
        this.pet.applyStyles();
        this.reminders.reset();
        this.close();
      });
    }
  }

  // =========================================================================
  // 9. STYLES (CSS INJECTION)
  // =========================================================================
  function injectStyles() {
    const style = document.createElement('style');
    style.textContent = `
      .desktop-pet-wrapper {
        position: fixed;
        z-index: 999999;
        user-select: none;
        cursor: grab;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: opacity 0.3s ease;
      }
      .desktop-pet-wrapper:active {
        cursor: grabbing;
      }
      .desktop-pet-wrapper.hidden {
        display: none !important;
      }

      .pet-media-box {
        width: var(--pet-size, 180px);
        height: var(--pet-size, 180px);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .pet-media {
        width: 100%;
        height: 100%;
        object-fit: contain;
        pointer-events: none;
      }

      /* SPEECH BUBBLE */
      .pet-speech-bubble {
        position: absolute;
        bottom: 100%;
        background: #ffffff;
        color: #333333;
        padding: 10px 14px;
        border-radius: 16px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 13px;
        font-weight: 500;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        white-space: nowrap;
        margin-bottom: 8px;
        opacity: 0;
        transform: translateY(10px) scale(0.95);
        transition: opacity 0.3s ease, transform 0.3s ease;
        pointer-events: none;
      }

      .pet-speech-bubble::after {
        content: '';
        position: absolute;
        bottom: -6px;
        left: 50%;
        transform: translateX(-50%);
        border-width: 6px 6px 0;
        border-style: solid;
        border-color: #ffffff transparent;
        display: block;
        width: 0;
      }

      .pet-speech-bubble.visible {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      /* ENTRANCE ANIMATIONS */
      .anim-enter-popup {
        animation: petPopUp var(--anim-speed, 0.8s) cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
      }
      .anim-enter-fade {
        animation: petFadeIn var(--anim-speed, 0.8s) ease forwards;
      }
      .anim-enter-slide {
        animation: petSlideIn var(--anim-speed, 0.8s) ease forwards;
      }

      /* EXIT ANIMATIONS */
      .anim-exit-slidedown {
        animation: petSlideDown var(--anim-speed, 0.8s) ease forwards;
      }

      @keyframes petPopUp {
        0% { transform: translateY(100%) scale(0.7); opacity: 0; }
        100% { transform: translateY(0) scale(1); opacity: 1; }
      }
      @keyframes petFadeIn {
        0% { opacity: 0; }
        100% { opacity: 1; }
      }
      @keyframes petSlideIn {
        0% { transform: translateX(100%); opacity: 0; }
        100% { transform: translateX(0); opacity: 1; }
      }
      @keyframes petSlideDown {
        0% { transform: translateY(0); opacity: 1; }
        100% { transform: translateY(100%); opacity: 0; }
      }

